# Copy to .env; generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_KEY=
HOST=127.0.0.1
PORT=3010
BASE_URL=https://cdn.example.com
# Default is this project directory, preserving existing cdn.db/uploads/keys.json installations.
# DATA_DIR=/var/lib/muizi-cdn
DEFAULT_VISIBILITY=public
DEFAULT_RETENTION_MINUTES=10080
MIN_RETENTION_MINUTES=1440
# Allows permanent retention for normal accounts; bootstrap owner retains its existing override.
ALLOW_PERMANENT=false
CLEANUP_INTERVAL_SECONDS=3600
TEMP_MAX_AGE_MINUTES=1440
MAX_UPLOAD_SIZE_GB=25
# MAX_UPLOAD_BYTES overrides MAX_UPLOAD_SIZE_GB, including limits below 1 GB.
# MAX_UPLOAD_BYTES=104857600
MAX_CONCURRENT_UPLOADS=4
UPLOAD_TIMEOUT_SECONDS=3600
MAX_USER_BYTES=0
# Zero means no per-user quota. Quotas count final stored file sizes, not input bandwidth.
# Temporary Access Links only. View Links follow their associated File Access Key expiration.
SIGNED_URL_MAX_SECONDS=900
CONVERT_MEDIA=true
FFMPEG_PATH=ffmpeg
CONVERSION_TIMEOUT_SECONDS=900
# Empty permits all detected types. Comma-separated MIME types enforce an allowlist.
ALLOWED_MIME_TYPES=
# Public CDN default. Set exact panel/application origins to restrict browser access.
CORS_ORIGINS=*

# New uploads use extensionless /FOLDER/UUID URLs backed by per-file folders.
# Existing UUID.ext URLs keep working regardless of this setting.
UPLOAD_URL_STYLE=folder
# Defaults to the common English profanity/slur list in lib/filenames.js.
# Uncomment to replace it with your own comma-separated whole words.
# An explicitly empty FILENAME_REDACT_WORDS disables word redaction.
# FILENAME_REDACT_WORDS=your,custom,list
FILENAME_REDACTION_TEXT=redacted
